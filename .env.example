# G2Bulk Supplier API Credentials (Get yours at https://g2bulk.com)
G2BULK_API_KEY=your_g2bulk_api_key_here

# Optional Ahnajak Pay (ABA PayWay / Bakong KHQR) Credentials (Get yours at https://aba.ahnajak.cyou)
AHNAJAK_PROFILE_ID=your_ahnajak_profile_id
AHNAJAK_SECRET_KEY=your_ahnajak_secret_key
